# ChangeRadar Environment Configuration Template
# Copy this file to backend/.env and customize with your own settings

# ==========================================
# 1. Database & Environment Configuration
# ==========================================
ENVIRONMENT=development
# DATABASE_URL=sqlite:///./changeradar.db

# ==========================================
# 2. Email Delivery & SMTP Configuration
# ==========================================
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# ==========================================
# 3. Client & Frontend URL
# ==========================================
FRONTEND_URL=http://localhost:5173
